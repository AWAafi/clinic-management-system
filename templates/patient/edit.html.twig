{% extends 'base.html.twig' %}

{% block title %}Edit Patient{% endblock %}

{% block body %}

 

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Modifier un patient</h4>
                    <a href="{{ path('patient.read') }}" class="btn btn-success">Liste des patients</a>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="class mb-3">
                        {{ form_row(form.nom, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="class mb-3">
                        {{ form_row(form.prenom, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    
                    <div class="class mb-3">
                        {{ form_row(form.adresse, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="class mb-3">
                        {{ form_row(form.tel, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    
                    <div class="class mb-3">
                        {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="class mb-3">
                        {{ form_row(form.age, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="class mb-3">
                        {{ form_row(form.sexe, {'attr': {'class': 'form-control'}}) }}
                    </div>

                   <div class="class mb-3">
                      {{ form_row(form.enregistrer, {'label': 'Modifier', 'attr': {'class': 'btn btn-primary'}}) }}
                   </div>


                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

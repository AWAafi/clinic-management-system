{% extends 'base.html.twig' %}

{% block title %}Add Utilisateur{% endblock %}

{% block body %}



<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>INSCRIPTION</h4>
                  
                    
                           
                </div>
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="class mb-3">
                        {{ form_row(form.prenom, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="class mb-3">
                        {{ form_row(form.nom, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    
                    <div class="class mb-3">
                        {{ form_row(form.profile, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="class mb-3">
                        {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    
                    <div class="class mb-3">
                        {{ form_row(form.password, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    

                    <div class="class mb-3">
                        {{ form_row(form.inscrire, {'attr': {'class': 'btn btn-primary'}}) }}
                    </div>
                    <a href="{{ path('inscription.add') }}" class="btn btn-danger float-right">Annuler</a>



                                
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
